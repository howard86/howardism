{
  "name": "howardism",
  "version": "2.33.1",
  "private": true,
  "repository": "https://github.com/howard86/howardism",
  "workspaces": [
    "apps/**",
    "packages/**"
  ],
  "scripts": {
    "build": "bun apps/cli/src/content/run.ts turbo run build",
    "check": "ultracite check",
    "clean": "bun run clean:packages && bun run clean:root",
    "clean:packages": "turbo run clean",
    "clean:root": "rm -rf node_modules",
    "cloudflare": "bun run --cwd apps/cli cloudflare",
    "content:acceptance": "bun apps/cli/src/content/index.ts acceptance",
    "content:backup-local": "bun apps/cli/src/content/index.ts backup-local",
    "content:export": "bun apps/cli/src/content/index.ts export",
    "content:fixtures": "bun apps/cli/src/content/index.ts fixtures",
    "content:fixtures-pack": "bun apps/cli/src/content/index.ts fixtures-pack",
    "content:fixtures-pin": "bun apps/cli/src/content/index.ts fixtures-pin",
    "content:fixtures-publish": "bun apps/cli/src/content/index.ts fixtures-publish",
    "content:gc": "bun apps/cli/src/content/index.ts gc",
    "content:pack": "bun apps/cli/src/content/index.ts pack",
    "content:pin": "bun apps/cli/src/content/index.ts pin",
    "content:prepare": "bun apps/cli/src/content/index.ts prepare",
    "content:publish": "bun apps/cli/src/content/index.ts publish",
    "content:validate": "bun apps/cli/src/content/index.ts validate",
    "content:verify-build": "bun apps/cli/src/content/build-evidence.ts",
    "content:verify-deployment": "bun apps/cli/src/content/verify-deployment.ts",
    "content:verify-parity": "bun apps/cli/src/content/deployment-parity.ts",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "knip": "knip",
    "lint": "bun apps/cli/src/content/run.ts turbo run lint",
    "lint:root": "ultracite check",
    "prepare": "husky",
    "test": "bun apps/cli/src/content/run.ts bun run test:prepared",
    "test:prepared": "turbo run test && bun apps/cli/src/content/index.ts validate && bun apps/cli/src/translate/index.ts --check --warn",
    "type-check": "bun apps/cli/src/content/run.ts turbo run type-check",
    "typecheck": "bun apps/cli/src/content/run.ts turbo run type-check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@howardism/test-config": "workspace:*",
    "@howardism/tsconfig": "workspace:*",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.0.0",
    "commitlint": "^21.2.2",
    "commitlint-config-gitmoji": "^2.3.1",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "semantic-release-gitmoji": "^1.6.9",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  }
}
