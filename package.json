{
  "name": "howardism",
  "version": "2.31.0",
  "private": true,
  "repository": "https://github.com/howard86/howardism",
  "workspaces": [
    "apps/**",
    "packages/**"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "clean": "bun run clean:packages && bun run clean:root",
    "clean:packages": "turbo run clean",
    "clean:root": "rm -rf node_modules",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "knip": "knip",
    "lint": "turbo run lint",
    "lint:root": "ultracite check",
    "prepare": "husky",
    "test": "turbo run test && bun apps/cli/src/content-check.ts && bun apps/cli/src/translate/index.ts --check --warn",
    "type-check": "turbo run type-check",
    "typecheck": "turbo run type-check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@howardism/test-config": "workspace:*",
    "@howardism/tsconfig": "workspace:*",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.9.7",
    "commitlint": "^21.2.2",
    "commitlint-config-gitmoji": "^2.3.1",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "semantic-release-gitmoji": "^1.6.9",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  }
}
