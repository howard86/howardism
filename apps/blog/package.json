{
  "name": "@howardism/blog",
  "version": "2.9.0",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true bun ../cli/src/content/run.ts bun run --bun next build",
    "bench": "bun ../cli/src/content/run.ts bun bench/run.ts",
    "build": "bun ../cli/src/content/run.ts bun run --bun next build",
    "clean": "rm -rf .content-state.json .next .turbo node_modules public/.well-known/howardism-content.json public/rss src/.content-coverage.json src/content src/data tsconfig.tsbuildinfo",
    "dev": "bun ../cli/src/content/run.ts bun run --bun next dev",
    "lint": "ultracite check",
    "start": "bun run --bun next start",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@howardism/article-contract": "workspace:*",
    "@howardism/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@mdx-js/loader": "^3.0.1",
    "@next/mdx": "^16.4.6",
    "@vercel/analytics": "^2.0.1",
    "estree-util-value-to-estree": "^3.5.0",
    "feed": "^6.0.0",
    "hast-util-heading-rank": "^3.0.0",
    "hast-util-to-string": "^3.0.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-html-props": "^2.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "unist-util-mdx-define": "^1.1.2",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
