{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "rootDir": "../..",
    "outDir": "dist/types",
    "typeRoots": ["../../apps/blog/node_modules/@types"],
    "types": ["react", "react-dom"],
    "paths": {
      "@/*": ["../../packages/ui/src/*", "../../apps/blog/src/*"],
      "@howardism/ui/*": ["../../packages/ui/src/*"],
      "next/link": ["./shims/next-link.tsx"],
      "next/navigation": ["./shims/next-navigation.ts"],
      "react": ["../../apps/blog/node_modules/@types/react"],
      "react/*": ["../../apps/blog/node_modules/@types/react/*"]
    }
  },
  "files": ["entry.ts"]
}
