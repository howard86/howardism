# claude code (local config ignored; shared skills tracked for reuse)
# `**/` so nested workspace configs (apps/*/.claude) follow the same rule
**/.claude/*
!**/.claude/skills/

# image-generation staging (apps/cli)
.codex-staging/
.agy-staging/

# antigravity (gemini) ide local cache
.antigravitycli/
# impeccable design-hook cache
.impeccable/

# Content is materialized from the pinned R2 release (apps/blog/content.lock.json)
# by `content:prepare`; authoring happens in an external CONTENT_ROOT.
apps/blog/src/content/
apps/blog/src/data/article-graph.json
apps/blog/src/data/articles-meta.json
apps/blog/src/data/articles-meta.zh-TW.json
apps/blog/src/data/open-questions.json
apps/blog/src/data/search-index.json
apps/blog/src/data/translations.json
apps/blog/src/data/wiki-sources.json

# Content preparation state.
apps/blog/.content-state.json
apps/blog/.content-prepare-lock/
apps/blog/.content-candidate-*/

apps/blog/public/.well-known/howardism-content.json

apps/blog/src/.content-coverage.json
apps/blog/.content-lock-*.tmp

apps/blog/.sample-lock-*.tmp

