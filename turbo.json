{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "out/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/content/**",
        "biome.json",
        "biome.jsonc",
        "../../biome.json",
        "../../biome.shared.jsonc"
      ]
    },
    "type-check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/content/**",
        "tsconfig.json",
        "../../packages/tsconfig/**"
      ]
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": ["apps/blog/.content-state.json"],
  "globalEnv": ["CONTENT_PROFILE", "DEPLOY_TARGET", "VERCEL_ENV"],
  "globalPassThroughEnv": [
    "HOWARDISM_PREPARED_ROOT",
    "CONTENT_ROOT",
    "VERCEL_GIT_COMMIT_SHA"
  ]
}
